



# Dependencies - huge, and regenerated by npm install
node_modules/

# Secrets - never commit these, this is the important one
.env
.env.*
.dev.vars

# Wrangler's local state - local D1 database files, cache, logs
.wrangler/

# Build output, if a build step ever gets added
dist/
build/

# Logs
*.log

# TypeScript incremental build cache
*.tsbuildinfo