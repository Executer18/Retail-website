{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true, 
    "skipLibCheck": true,
    
    "lib": [
      "ESNext"
      
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "allowJs": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*"]
  
}