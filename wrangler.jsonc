{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "retail-website",
	"main": "src/index.tsx",
	"compatibility_date": "2026-09-13",
	// Staging environments handle your live mobile sandboxes safely
	"env": {
		"staging": {
			"name": "retail-website-staging"
      
	}},
	"d1_databases" : [
		{
			"binding": "DB",
			"database_name": "attachakki-db",
			"database_id": "713935c1-b238-4697-8f0e-bcf6d7564f6e",
			"remote": true,
      "migrations_dir" : "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	 "compatibility_flags": [
	   "nodejs_compat"
	 ],
